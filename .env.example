# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/maternal_care?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# JWT — MUST be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# SMTP (Nodemailer)
# For Gmail: host=smtp.gmail.com, port=587, enable 2FA then generate an App Password
# For Outlook: host=smtp-mail.outlook.com, port=587
# For Yahoo: host=smtp.mail.yahoo.com, port=587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="MaternalCare"
SMTP_FROM_EMAIL="your-email@gmail.com"

# App
NEXT_PUBLIC_APP_NAME="MaternalCare"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI API Keys
GROQ_API_KEY="your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENROUTER_API_KEY="your-agentrouter-api-key-here"

# TOTP Encryption Key — separate from JWT_SECRET. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY="change-me-to-a-random-hex-key-at-least-64-chars"

# Cron Secret — used to authenticate cron job requests (e.g., Vercel Cron Jobs)
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-random-cron-secret"